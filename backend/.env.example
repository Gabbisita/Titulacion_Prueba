# =======================================================
# PLANTILLA DE CONFIGURACIÓN — Safe Stock CETI (backend)
# =======================================================
# 1. Copia este archivo como  backend/.env
# 2. Llena los valores reales.
# 3. NUNCA subas backend/.env a GitHub (ya está en .gitignore).
#    Este archivo de ejemplo SÍ se sube, por eso no lleva ningún secreto.

# ---- Base de datos (TiDB Cloud / MySQL) ----
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASS=
DB_NAME=
# Solo para una base local de pruebas sin TLS:  DB_SSL=false

# ---- Secretos del servidor ----
# Genera cada uno con:  npm run claves   (usa un valor DISTINTO para cada variable)
# Firma de las sesiones (mínimo 32 caracteres). Si se cambia, todos deben volver a iniciar sesión.
JWT_SECRET=
# Clave de cifrado de los códigos QR. Si se cambia, los QR ya emitidos dejan de funcionar.
QR_SECRET=
# Clave que el casillero (ESP32) manda en el encabezado X-API-Key (mínimo 24 caracteres).
CASILLERO_API_KEY=

# ---- Correo (Gmail con contraseña de aplicación) ----
SMTP_USER=
SMTP_PASS=

# ---- Opcionales ----
# PORT=5000
# NODE_ENV=production        # en el servidor definitivo: obliga cookies solo por HTTPS
# CORS_ORIGENES=https://midominio.mx   # otros sitios que pueden llamar a la API (separados por coma)
